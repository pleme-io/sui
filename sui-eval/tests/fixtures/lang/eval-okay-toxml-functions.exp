"<?xml version='1.0' encoding='utf-8'?>\n<expr>\n  <attrs>\n    <attr name=\"both\">\n      <function>\n        <attrspat ellipsis=\"1\" name=\"args\">\n          <attr name=\"a\" />\n        </attrspat>\n      </function>\n    </attr>\n    <attr name=\"bound\">\n      <function>\n        <attrspat name=\"args\">\n          <attr name=\"a\" />\n        </attrspat>\n      </function>\n    </attr>\n    <attr name=\"ell\">\n      <function>\n        <attrspat ellipsis=\"1\">\n          <attr name=\"a\" />\n        </attrspat>\n      </function>\n    </attr>\n    <attr name=\"partial\">\n      <unevaluated />\n    </attr>\n    <attr name=\"pat\">\n      <function>\n        <attrspat>\n          <attr name=\"a\" />\n          <attr name=\"b\" />\n        </attrspat>\n      </function>\n    </attr>\n    <attr name=\"primop\">\n      <unevaluated />\n    </attr>\n    <attr name=\"simple\">\n      <function>\n        <varpat name=\"x\" />\n      </function>\n    </attr>\n  </attrs>\n</expr>\n"