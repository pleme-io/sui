"<?xml version='1.0' encoding='utf-8'?>\n<expr>\n  <attrs>\n    <attr name=\"a\">\n      <int value=\"2\" />\n    </attr>\n    <attr name=\"b\">\n      <list>\n        <int value=\"4\" />\n        <list>\n          <int value=\"3\" />\n        </list>\n      </list>\n    </attr>\n    <attr name=\"c\">\n      <attrs>\n        <attr name=\"d\">\n          <attrs>\n            <attr name=\"e\">\n              <string value=\"deep\" />\n            </attr>\n          </attrs>\n        </attr>\n      </attrs>\n    </attr>\n  </attrs>\n</expr>\n"